# Copiá este archivo como .env.local y completá los valores.

# MongoDB Atlas: dirección de conexión con el nombre de la base (tia-norma) antes del "?".
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/tia-norma?retryWrites=true&w=majority

# Gemini, para leer el cartelito escrito a mano. Opcional: sin clave, Norma escribe los datos.
GEMINI_API_KEY=

# Vercel Blob, para guardar las fotos. Lo agrega Vercel al conectar el Blob store al proyecto.
BLOB_READ_WRITE_TOKEN=

# Opcional: servidores DNS para Node si falla la conexion con 'querySrv ECONNREFUSED'.
MONGODB_DNS=
